{
  "PostgreSQL": {
    "SecretArn": "arn:aws:secretsmanager:us-east-1:<account>:secret:<rds-cluster-secret>",
    "Host": "<cluster-endpoint>.rds.amazonaws.com",
    "Port": "5432",
    "Database": "<database-name>"
  },
  "Admin": {
    "_comment": "SHA-256 (lowercase hex) of the admin password required for --admin (write) mode.",
    "PasswordHash": "<sha256-hex-of-admin-password>"
  }
}
